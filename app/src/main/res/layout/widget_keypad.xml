<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp">
 <ImageView android:id="@+id/art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:background="@drawable/widget_bg"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Enter date of birth" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
   <TextView android:id="@+id/key_cancel" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="×" android:textColor="#D6DCE9" android:textSize="24sp"/>
  </LinearLayout>
  <TextView android:id="@+id/key_display" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:gravity="center" android:background="@drawable/widget_field" android:text="MM/DD/YYYY" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.08"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <TextView android:id="@+id/key_1" style="@style/WidgetKey" android:text="1"/><TextView android:id="@+id/key_2" style="@style/WidgetKey" android:text="2"/><TextView android:id="@+id/key_3" style="@style/WidgetKey" android:text="3"/><TextView android:id="@+id/key_4" style="@style/WidgetKey" android:text="4"/>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <TextView android:id="@+id/key_5" style="@style/WidgetKey" android:text="5"/><TextView android:id="@+id/key_6" style="@style/WidgetKey" android:text="6"/><TextView android:id="@+id/key_7" style="@style/WidgetKey" android:text="7"/><TextView android:id="@+id/key_8" style="@style/WidgetKey" android:text="8"/>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <TextView android:id="@+id/key_back" style="@style/WidgetKey" android:text="⌫"/><TextView android:id="@+id/key_9" style="@style/WidgetKey" android:text="9"/><TextView android:id="@+id/key_0" style="@style/WidgetKey" android:text="0"/><TextView android:id="@+id/key_done" style="@style/WidgetKeyAccent" android:text="✓"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
